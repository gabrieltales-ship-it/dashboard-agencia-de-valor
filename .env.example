# Copie este arquivo para .env e preencha com seus tokens reais
# NUNCA suba o arquivo .env para o GitHub — ele já está no .gitignore

# Pipedrive
PIPEDRIVE_TOKEN=seu_token_aqui

# Google Sheets
GOOGLE_SHEETS_KEY=sua_chave_de_servico_aqui
SPREADSHEET_ID=id_da_sua_planilha_aqui

# Meta Ads (conectar por último)
META_TOKEN=seu_token_aqui
META_AD_ACCOUNT_ID=act_XXXXXXXXX
# Contas adicionais (opcionais) — mesmo token, somadas ao total
META_AD_ACCOUNT_ID_2=
META_AD_ACCOUNT_ID_3=

# Supabase (camada de cache) — Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
# Opcional: protege /api/refresh contra chamadas externas
CRON_SECRET=
